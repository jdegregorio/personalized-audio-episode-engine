# Copy values into the external secrets file described in docs/setup.md.
# Never place real values in this repository.

# Secrets
GEMINI_API_KEY=<gemini-api-key>
PODCAST_FEED_TOKEN=<at-least-32-random-bytes-url-safe>
R2_ACCESS_KEY_ID=<bucket-scoped-access-key-id>
R2_SECRET_ACCESS_KEY=<bucket-scoped-secret-access-key>

# Non-secret environment-specific settings
R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET_NAME=<dedicated-bucket-name>
PODCAST_BASE_URL=https://<public-r2-origin>
R2_RETENTION_DAYS=30

# Stable paths outside feature worktrees are recommended for scheduled use.
AUDIO_ENGINE_RUNTIME_ROOT=<absolute-runtime-directory>
AUDIO_ENGINE_STAGING_ROOT=<absolute-staging-directory>
